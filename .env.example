# Copy this file to .env:   cp .env.example .env
# Never commit .env to GitHub.

# Django
# Must be 50+ random characters (the app refuses to start otherwise). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=False

# PostgreSQL (used by both the db and web containers)
POSTGRES_DB=securescan
POSTGRES_USER=securescan
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Scanner
SCAN_RATE_LIMIT=10/hour
SCANNER_TIMEOUT=8
